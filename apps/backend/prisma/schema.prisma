generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// better-auth's user. The better-auth CLI generates its auth columns and the
// auth models at the end of this file from src/auth/auth.ts, and maps them to
// lower-case tables ("user", "session", ...). type and status are ours:
// better-auth never writes them, so self sign-ups get the defaults.
// Phone-only customers carry a placeholder email (@microbuilt/shared).

model User {
  id                  String     @id
  name                String
  email               String     @unique
  emailVerified       Boolean    @default(false)
  image               String?
  phoneNumber         String?
  phoneNumberVerified Boolean?
  twoFactorEnabled    Boolean?   @default(false)
  type                UserType   @default(CUSTOMER)
  status              UserStatus @default(FLAGGED)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  customer       Customer?
  admin          Admin?
  notifications  Notification[]
  changeRequests ChangeRequest[]
  sessions       Session[]
  accounts       Account[]
  twofactors     TwoFactor[]
  passkeys       Passkey[]
  confirmations  Confirmation[]

  @@unique([phoneNumber])
  @@map("user")
}

enum UserType {
  CUSTOMER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  FLAGGED
}

model Customer {
  userId           String   @id
  externalId       String?  @unique
  flagReason       String?
  accountOfficerId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountOfficer Admin? @relation(fields: [accountOfficerId], references: [userId], onUpdate: Cascade)
  loans          Loan[] @relation("Borrower")

  identity      CustomerIdentity?
  paymentMethod CustomerPaymentMethod?
  payroll       CustomerPayroll?

  paymentInflows PaymentInflow[]

  @@index([accountOfficerId])
}

model CustomerIdentity {
  userId                String        @id
  dateOfBirth           DateTime      @db.Date
  gender                Gender
  maritalStatus         MaritalStatus
  residencyAddress      String
  stateResidency        String
  landmarkOrBusStop     String
  nextOfKinName         String
  nextOfKinContact      String
  nextOfKinAddress      String
  nextOfKinRelationship Relationship
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  customer Customer @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: Cascade)
}

enum Gender {
  Female
  Male
}

enum MaritalStatus {
  Single
  Married
  Divorced
  Widowed
}

enum Relationship {
  Spouse
  Parent
  Child
  Sibling
  Other
}

model CustomerPaymentMethod {
  userId        String   @id
  bankName      String
  accountNumber String   @unique
  accountName   String
  bvn           String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customer Customer @relation(fields: [userId], references: [userId], onDelete: Cascade)
}

// Keyed by externalId, not userId

model CustomerPayroll {
  externalId     String   @id
  netPay         Decimal  @default(0) @db.Decimal(18, 2)
  employeeGross  Decimal  @default(0) @db.Decimal(18, 2)
  grade          String?
  step           Int?
  command        String
  /// Set where the record is created; after that it changes only through an ORGANIZATION change request (PLAN_V2 P2).
  organizationId String
  updatedAt      DateTime @updatedAt

  customer     Customer     @relation(fields: [externalId], references: [externalId], onDelete: Cascade, onUpdate: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

// An employer whose payroll deducts repayments (NPF, Navy…). Variations and vouchers are per organization
// (PLAN_V2). Names are matched on normalizedName: trimmed, lower case, single spaces.

/// PENDING: named by an admin or marketer (onboarding, a payroll record, the organizations page) and waiting for a
/// super admin. Its customers are in it, but no variation is generated for it until it is approved (or merged into
/// the organization it misspelt).
enum OrganizationStatus {
  ACTIVE
  PENDING
}

model Organization {
  id             String             @id @default(cuid())
  name           String
  normalizedName String             @unique
  status         OrganizationStatus @default(ACTIVE)
  requestedById  String?
  createdAt      DateTime           @default(now())

  requestedBy Admin?            @relation("OrganizationRequestedBy", fields: [requestedById], references: [userId], onDelete: SetNull)
  payrolls    CustomerPayroll[]
  variations  Variation[]
}

model Admin {
  userId String    @id
  role   AdminRole @default(ADMIN)

  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  officerCustomers Customer[]

  requestedLoans         Loan[]          @relation("RequestedByAdmin")
  requestedTenureChanges TenureChange[]  @relation("TenureChangeRequestedByAdmin")
  vouchers               Voucher[]
  auditLogs              AuditLog[]
  decidedChangeRequests  ChangeRequest[] @relation("ChangeRequestDecidedBy")
  proposedChangeRequests ChangeRequest[] @relation("ChangeRequestRequestedBy")
  requestedOrganizations Organization[]  @relation("OrganizationRequestedBy")
}

enum AdminRole {
  ADMIN
  MARKETER
  SUPER_ADMIN
  SYSTEM
}

// One live loan per customer — enforced in invariants.sql.

model Loan {
  id                String       @id @default(cuid())
  borrowerId        String
  category          LoanCategory
  status            LoanStatus   @default(PENDING)
  interestRate      Decimal      @db.Decimal(5, 4)
  managementFeeRate Decimal      @db.Decimal(5, 4)
  tenure            Int

  principal Decimal @default(0) @db.Decimal(18, 2)
  owed      Decimal @default(0) @db.Decimal(18, 2)
  repaid    Decimal @default(0) @db.Decimal(18, 2)

  disbursementDate DateTime?
  requestedById    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  borrower      Customer        @relation("Borrower", fields: [borrowerId], references: [userId], onUpdate: Cascade)
  requestedBy   Admin?          @relation("RequestedByAdmin", fields: [requestedById], references: [userId], onUpdate: Cascade)
  microLoans    MicroLoan[]
  commodities   CommodityLoan[]
  repayments    Repayment[]
  deductions    Deduction[]
  tenureChanges TenureChange[]

  @@index([borrowerId])
}

enum LoanCategory {
  EDUCATION
  PERSONAL
  BUSINESS
  MEDICAL
  RENT
  TRAVEL
  AGRICULTURE
  UTILITIES
  EMERGENCY
  OTHERS
  ASSET_PURCHASE
}

enum LoanStatus {
  PENDING
  REJECTED
  APPROVED
  DISBURSED
  REPAID
}

// Only a TOPUP starts PENDING (then APPROVED, DISBURSED or REJECTED); every
// other purpose is applied on creation. amount > 0 — enforced in
// invariants.sql.

model MicroLoan {
  id          String           @id @default(cuid())
  loanId      String
  amount      Decimal          @db.Decimal(18, 2)
  purpose     MicroLoanPurpose
  status      MicroLoanStatus  @default(DISBURSED)
  disbursedAt DateTime?
  /// A PENALTY charged when this variation locked (PLAN_V2 R4): what a revert or a rematch removes.
  variationId String?
  createdAt   DateTime         @default(now())

  loan         Loan           @relation(fields: [loanId], references: [id], onDelete: Restrict)
  variation    Variation?     @relation(fields: [variationId], references: [id])
  commodity    CommodityLoan?
  tenureChange TenureChange?

  @@index([loanId])
}

enum MicroLoanPurpose {
  NEW_LOAN
  TOPUP
  INTEREST
  PENALTY
}

enum MicroLoanStatus {
  PENDING
  APPROVED
  REJECTED
  DISBURSED
}

// An asset request. microLoanId is the microloan that pays for it: the
// NEW_LOAN, linked when the loan is disbursed, or a TOPUP, linked when the
// top-up is requested.

model CommodityLoan {
  id             String                 @id @default(cuid())
  loanId         String
  commodityId    String
  status         CommodityRequestStatus @default(IN_REVIEW)
  microLoanId    String?                @unique
  publicDetails  String?
  privateDetails String?
  createdAt      DateTime               @default(now())

  loan      Loan       @relation(fields: [loanId], references: [id], onDelete: Cascade)
  commodity Commodity  @relation(fields: [commodityId], references: [id], onDelete: Restrict)
  microLoan MicroLoan? @relation(fields: [microLoanId], references: [id], onDelete: Restrict)

  @@index([loanId])
}

enum CommodityRequestStatus {
  IN_REVIEW
  APPROVED
  REJECTED
}

model Commodity {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  loans CommodityLoan[]
}

// A proposed change to a loan's tenure; monthsDelta is signed. Approval sets
// previousTenure and moves Loan.tenure. requestedById is null when the system
// proposed it (the net-pay cap after a default). A TOPUP change carries the
// top-up it was requested with. One PENDING change per loan — enforced in
// invariants.sql.

model TenureChange {
  id             String             @id @default(cuid())
  loanId         String
  previousTenure Int
  monthsDelta    Int
  reason         TenureChangeReason
  status         TenureChangeStatus @default(PENDING)
  microLoanId    String?            @unique
  requestedById  String?
  /// Lengthening only: also book interest for the added months (see ledger.math repriceInterest).
  reprice        Boolean            @default(false)
  /// The interest booked when a repriced change was applied.
  interestAdded  Decimal?           @db.Decimal(18, 2)
  /// A net-pay cap proposal made when this variation locked (PLAN_V2 R4): withdrawn by a revert while PENDING.
  variationId    String?
  createdAt      DateTime           @default(now())

  loan        Loan       @relation(fields: [loanId], references: [id], onDelete: Restrict)
  variation   Variation? @relation(fields: [variationId], references: [id])
  microLoan   MicroLoan? @relation(fields: [microLoanId], references: [id], onDelete: Restrict)
  requestedBy Admin?     @relation("TenureChangeRequestedByAdmin", fields: [requestedById], references: [userId], onUpdate: Cascade)

  @@index([loanId])
}

enum TenureChangeReason {
  DEFAULT
  TOPUP
  LIQUIDATION
  ADMIN
}

enum TenureChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

// Money that arrived. Its period is the inflow's period. Payroll repayments
// settle a Deduction; liquidations have no deductionId and instead trigger
// a refresh of the OPEN Deduction. amount > 0 — enforced in invariants.sql.

model Repayment {
  id              String   @id @default(cuid())
  loanId          String
  paymentInflowId String   @unique
  deductionId     String?
  amount          Decimal  @db.Decimal(18, 2)
  createdAt       DateTime @default(now())

  loan          Loan                 @relation(fields: [loanId], references: [id], onDelete: Restrict)
  paymentInflow PaymentInflow        @relation(fields: [paymentInflowId], references: [id])
  deduction     Deduction?           @relation(fields: [deductionId], references: [id])
  breakdown     RepaymentBreakdown[]

  @@index([loanId])
  @@index([deductionId])
}

// What a loan is expected to pay in a month (PLAN_V2 §1).
//
//   OPEN      - `expected` is recomputed on every change to the loan's
//               owed/repaid/tenure. At most one per loan.
//   AWAITING  - frozen into its organization's variation (variationId): what
//               payroll has on file, waiting for the voucher. A loan that
//               changes after the variation was generated also gets an OPEN
//               row for the next month.
//   FULFILLED / PARTIAL / FAILED - settled when the variation locks (its
//               voucher, or no payroll).
//
// penalizedAt marks the lock that settled the row (penalty or not), so
// re-running the settlement skips it.
//
// One OPEN row per loan and expected >= 0 — enforced in invariants.sql.

model Deduction {
  id          String          @id @default(cuid())
  loanId      String
  periodId    String
  variationId String?
  expected    Decimal         @db.Decimal(18, 2)
  status      DeductionStatus @default(OPEN)
  settledAt   DateTime?
  penalizedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  loan       Loan        @relation(fields: [loanId], references: [id], onDelete: Restrict)
  period     Period      @relation(fields: [periodId], references: [id])
  variation  Variation?  @relation(fields: [variationId], references: [id])
  repayments Repayment[]

  @@unique([loanId, periodId])
  @@index([periodId, status])
  @@index([variationId, status])
}

enum DeductionStatus {
  OPEN
  AWAITING
  FULFILLED
  PARTIAL
  FAILED
}

// A calendar month. Deductions and inflows belong to one; each organization's
// variation for it is a Variation.

model Period {
  id        String   @id @default(cuid())
  month     Month
  year      Int
  createdAt DateTime @default(now())

  deductions     Deduction[]
  paymentInflows PaymentInflow[]
  variations     Variation[]

  @@unique([year, month])
}

// One organization's variation for one month (PLAN_V2 P3). It holds every
// deduction it froze; its file (private `variations` bucket) lists only the
// ones that changed. Generating again replaces the file (version + 1) until
// the variation locks: a voucher, or noPayrollReason when none came.

model Variation {
  id              String   @id @default(cuid())
  periodId        String
  organizationId  String
  version         Int      @default(1)
  filePath        String
  noPayrollReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  period        Period         @relation(fields: [periodId], references: [id])
  organization  Organization   @relation(fields: [organizationId], references: [id])
  voucher       Voucher?
  deductions    Deduction[]
  penalties     MicroLoan[]
  tenureChanges TenureChange[]

  @@unique([periodId, organizationId])
  @@index([organizationId])
}

enum Month {
  JANUARY
  FEBRUARY
  MARCH
  APRIL
  MAY
  JUNE
  JULY
  AUGUST
  SEPTEMBER
  OCTOBER
  NOVEMBER
  DECEMBER
}

model RepaymentBreakdown {
  id          String             @id @default(cuid())
  repaymentId String
  amount      Decimal            @db.Decimal(18, 2)
  component   RepaymentComponent

  repayment Repayment @relation(fields: [repaymentId], references: [id], onDelete: Restrict)

  @@index([repaymentId])
}

enum RepaymentComponent {
  PRINCIPAL
  PENALTY
  INTEREST
}

// One organization's repayment file for one month, uploaded into its
// variation (one voucher per variation; it locks it). Each row becomes a
// PAYROLL PaymentInflow. fileHash rejects the identical file early with a
// clear error; the row-level index on PaymentInflow is what actually prevents
// double counting. Reverting a voucher removes exactly the inflows carrying
// its id (PLAN_V2 R6).

model Voucher {
  id           String   @id @default(cuid())
  variationId  String   @unique
  fileHash     String   @unique
  filename     String
  uploadedById String
  createdAt    DateTime @default(now())

  variation  Variation       @relation(fields: [variationId], references: [id])
  uploadedBy Admin           @relation(fields: [uploadedById], references: [userId], onUpdate: Cascade)
  inflows    PaymentInflow[]
}

// A payroll inflow is one row of a Voucher; its periodId is the voucher's
// month (kept here for the index below). A liquidation has no voucher and
// belongs to the month open when it arrived.
//
// A liquidation carries its proof: a path in the private proofs bucket.
//
// Re-uploading a payroll return must not double count: one PAYROLL row per
// employee per period — enforced in invariants.sql, as is the proof on every
// liquidation.

model PaymentInflow {
  id             String              @id @default(cuid())
  source         PaymentInflowSource
  periodId       String
  voucherId      String?
  amount         Decimal             @db.Decimal(18, 2)
  customerId     String?
  externalUserId String?
  state          PaymentInflowState  @default(UNMATCHED)
  proofPath      String?
  createdAt      DateTime            @default(now())

  period    Period     @relation(fields: [periodId], references: [id])
  voucher   Voucher?   @relation(fields: [voucherId], references: [id])
  customer  Customer?  @relation(fields: [customerId], references: [userId], onUpdate: Cascade)
  repayment Repayment?

  @@index([customerId])
  @@index([periodId])
  @@index([voucherId])
}

enum PaymentInflowSource {
  PAYROLL
  LIQUIDATION
  /// What an imported running loan had already repaid before it came over (the sheet's "amount paid").
  IMPORT
}

enum PaymentInflowState {
  UNMATCHED
  AWAITING
  REVIEWING
  SETTLED
  REJECTED
}

// Platform-wide settings: a single row (id = 1, enforced in
// invariants.sql). Set by a super admin on the dashboard, never seeded; a
// null rate means "not set yet". maxDeductionRate is the largest share of a
// customer's net pay the monthly deduction may take (null = no cap).

model Settings {
  id                Int      @id @default(1)
  interestRate      Decimal? @db.Decimal(5, 4)
  managementFeeRate Decimal? @db.Decimal(5, 4)
  penaltyRate       Decimal? @db.Decimal(5, 4)
  maxDeductionRate  Decimal? @db.Decimal(5, 4)
  inMaintenance     Boolean  @default(false)
  updatedAt         DateTime @updatedAt
}

// In-app notifications; readAt is null while unread.

model Notification {
  id              String    @id @default(cuid())
  userId          String
  title           String
  description     String
  callToActionUrl String?
  /// What an admin prompt is about (e.g. "liquidation:<inflowId>"): cleared for everyone once it is acted on.
  subject         String?
  readAt          DateTime?
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, createdAt])
  @@index([subject])
}

// A change to someone's details that waits for an admin: the customer's identity or payment
// method, or anyone's profile (name, email, phone) except a super admin's. `proposed`
// holds only the fields being changed; `previous` their values when they were asked for. A
// later edit of the same kind folds into the pending request. Approving writes `proposed` to
// the live record. One PENDING request per user and kind — enforced in invariants.sql.

/// A signed-in user proving it's them again (authenticator code or passkey) before a gated action. A passkey
/// ceremony starts as a challenge (challenge set, confirmedAt null). Once confirmed, an "action" gate spends it
/// (usedAt) and a "window" gate accepts any confirmation of the same session from the last few minutes.
model Confirmation {
  id          String              @id
  userId      String
  sessionId   String
  method      ConfirmationMethod?
  challenge   String?
  confirmedAt DateTime?
  usedAt      DateTime?
  expiresAt   DateTime
  createdAt   DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([sessionId, confirmedAt])
  @@index([expiresAt])
}

enum ConfirmationMethod {
  TOTP
  PASSKEY
}

model ChangeRequest {
  id            String              @id @default(cuid())
  userId        String
  kind          ChangeRequestKind
  status        ChangeRequestStatus @default(PENDING)
  proposed      Json
  previous      Json
  decidedById   String?
  decidedAt     DateTime?
  note          String?
  /// The admin who proposed it on the customer's behalf; null when the user asked themselves. Only a super admin
  /// decides an admin's proposal.
  requestedById String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  decidedBy   Admin? @relation("ChangeRequestDecidedBy", fields: [decidedById], references: [userId], onUpdate: Cascade)
  requestedBy Admin? @relation("ChangeRequestRequestedBy", fields: [requestedById], references: [userId], onUpdate: Cascade)

  @@index([status, kind, createdAt])
  @@index([userId, createdAt])
}

enum ChangeRequestKind {
  IDENTITY
  PAYMENT_METHOD
  PROFILE
  /// A customer's first payroll record (IPPIS, command, organization), proposed by an admin; after that payroll
  /// changes only through vouchers, and the organization only through ORGANIZATION.
  PAYROLL
  /// Moving a customer to another organization (payload { organizationId }): any admin proposes, a SUPER_ADMIN approves.
  ORGANIZATION
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// What an admin (or the system actor) did, for the super admins' audit page. `meta` holds
// structured detail where a note isn't enough, e.g. a settings change's before and after.

model AuditLog {
  id         String          @id @default(cuid())
  actorId    String
  action     AuditAction
  entityType AuditEntityType
  entityId   String
  note       String?
  meta       Json?
  createdAt  DateTime        @default(now())

  actor Admin @relation(fields: [actorId], references: [userId], onUpdate: Cascade)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([actorId, createdAt])
}

enum AuditAction {
  LOAN_APPROVED
  LOAN_REJECTED
  LOAN_DISBURSED
  TOPUP_APPROVED
  TOPUP_REJECTED
  TOPUP_DISBURSED
  PENALTY_APPLIED
  TENURE_CHANGE_PROPOSED
  TENURE_CHANGE_APPROVED
  TENURE_CHANGE_REJECTED
  PAYMENT_INFLOW_APPROVED
  PAYMENT_INFLOW_REJECTED
  VARIATION_GENERATED
  VARIATION_REVERTED
  VOUCHER_UPLOADED
  VOUCHER_REVERTED
  NO_PAYROLL
  NO_PAYROLL_REVERTED
  COMMODITY_APPROVED
  COMMODITY_REJECTED
  CUSTOMER_STATUS_CHANGED
  CUSTOMER_OFFICER_CHANGED
  ADMIN_INVITED
  ADMIN_REMOVED
  CHANGE_REQUEST_APPROVED
  CHANGE_REQUEST_REJECTED
  CHANGE_REQUEST_PROPOSED
  SETTINGS_UPDATED
  MAINTENANCE_TOGGLED
  COMMODITY_ADDED
  COMMODITY_UPDATED
  COMMODITY_DELETED
  ADMIN_ROLE_CHANGED
  SIGN_IN_RESET
  CUSTOMER_ONBOARDED
  CUSTOMERS_IMPORTED
  DATA_EXPORTED
  DOCUMENT_GENERATED
  ORGANIZATIONS_MERGED
  ORGANIZATION_CREATED
  ORGANIZATION_RENAMED
  ORGANIZATION_DELETED
  ORGANIZATION_APPROVED
}

enum AuditEntityType {
  LOAN
  MICRO_LOAN
  TENURE_CHANGE
  PAYMENT_INFLOW
  VARIATION
  COMMODITY_LOAN
  USER
  VOUCHER
  CHANGE_REQUEST
  SETTINGS
  COMMODITY
  FILE
  ORGANIZATION
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime?
  aaguid       String?

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}
