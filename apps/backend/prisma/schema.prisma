
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// better-auth's user. The better-auth CLI generates its auth columns and the
// auth models at the end of this file from src/auth/auth.ts, and maps them to
// lower-case tables ("user", "session", ...). type and status are ours:
// better-auth never writes them, so self sign-ups get the defaults.
// Phone-only customers carry a placeholder email (@microbuilt/shared).

model User {
  id                  String     @id
  name                String
  email               String     @unique
  emailVerified       Boolean    @default(false)
  image               String?
  phoneNumber         String?
  phoneNumberVerified Boolean?
  twoFactorEnabled    Boolean?   @default(false)
  type                UserType   @default(CUSTOMER)
  status              UserStatus @default(FLAGGED)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  customer      Customer?
  admin         Admin?
  notifications  Notification[]
  changeRequests ChangeRequest[]
  sessions       Session[]
  accounts      Account[]
  twofactors    TwoFactor[]
  passkeys      Passkey[]

  @@unique([phoneNumber])
  @@map("user")
}

enum UserType {
  CUSTOMER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  FLAGGED
}

model Customer {
  userId           String   @id
  externalId       String?  @unique
  flagReason       String?
  accountOfficerId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountOfficer Admin? @relation(fields: [accountOfficerId], references: [userId], onUpdate: Cascade)
  loans          Loan[] @relation("Borrower")

  identity      CustomerIdentity?
  paymentMethod CustomerPaymentMethod?
  payroll       CustomerPayroll?

  paymentInflows PaymentInflow[]

  @@index([accountOfficerId])
}

model CustomerIdentity {
  userId                String        @id
  dateOfBirth           DateTime      @db.Date
  gender                Gender
  maritalStatus         MaritalStatus
  residencyAddress      String
  stateResidency        String
  landmarkOrBusStop     String
  nextOfKinName         String
  nextOfKinContact      String
  nextOfKinAddress      String
  nextOfKinRelationship Relationship
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  customer Customer @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: Cascade)
}

enum Gender {
  Female
  Male
}

enum MaritalStatus {
  Single
  Married
  Divorced
  Widowed
}

enum Relationship {
  Spouse
  Parent
  Child
  Sibling
  Other
}

model CustomerPaymentMethod {
  userId        String   @id
  bankName      String
  accountNumber String   @unique
  accountName   String
  bvn           String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customer Customer @relation(fields: [userId], references: [userId], onDelete: Cascade)
}

// Keyed by externalId, not userId

model CustomerPayroll {
  externalId    String   @id
  netPay        Decimal  @default(0) @db.Decimal(18, 2)
  employeeGross Decimal  @default(0) @db.Decimal(18, 2)
  grade         String?
  step          Int?
  command       String
  organization  String
  updatedAt     DateTime @updatedAt

  customer Customer @relation(fields: [externalId], references: [externalId], onDelete: Cascade, onUpdate: Cascade)
}

model Admin {
  userId String    @id
  role   AdminRole @default(ADMIN)

  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  officerCustomers Customer[]

  requestedLoans         Loan[]          @relation("RequestedByAdmin")
  requestedTenureChanges TenureChange[]  @relation("TenureChangeRequestedByAdmin")
  payrollUploads         PayrollUpload[]
  auditLogs              AuditLog[]
  decidedChangeRequests  ChangeRequest[]  @relation("ChangeRequestDecidedBy")
}

enum AdminRole {
  ADMIN
  MARKETER
  SUPER_ADMIN
  SYSTEM
}

// One live loan per customer — enforced in invariants.sql.

model Loan {
  id                String       @id @default(cuid())
  borrowerId        String
  category          LoanCategory
  status            LoanStatus   @default(PENDING)
  interestRate      Decimal      @db.Decimal(5, 4)
  managementFeeRate Decimal      @db.Decimal(5, 4)
  tenure            Int

  principal Decimal @default(0) @db.Decimal(18, 2)
  owed      Decimal @default(0) @db.Decimal(18, 2)
  repaid    Decimal @default(0) @db.Decimal(18, 2)

  disbursementDate DateTime?
  requestedById    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  borrower      Customer        @relation("Borrower", fields: [borrowerId], references: [userId], onUpdate: Cascade)
  requestedBy   Admin?          @relation("RequestedByAdmin", fields: [requestedById], references: [userId], onUpdate: Cascade)
  microLoans    MicroLoan[]
  commodities   CommodityLoan[]
  repayments    Repayment[]
  deductions    Deduction[]
  tenureChanges TenureChange[]

  @@index([borrowerId])
}

enum LoanCategory {
  EDUCATION
  PERSONAL
  BUSINESS
  MEDICAL
  RENT
  TRAVEL
  AGRICULTURE
  UTILITIES
  EMERGENCY
  OTHERS
  ASSET_PURCHASE
}

enum LoanStatus {
  PENDING
  REJECTED
  APPROVED
  DISBURSED
  REPAID
}

// Only a TOPUP starts PENDING (then APPROVED, DISBURSED or REJECTED); every
// other purpose is applied on creation. amount > 0 — enforced in
// invariants.sql.

model MicroLoan {
  id          String           @id @default(cuid())
  loanId      String
  amount      Decimal          @db.Decimal(18, 2)
  purpose     MicroLoanPurpose
  status      MicroLoanStatus  @default(DISBURSED)
  disbursedAt DateTime?
  createdAt   DateTime         @default(now())

  loan         Loan           @relation(fields: [loanId], references: [id], onDelete: Restrict)
  commodity    CommodityLoan?
  tenureChange TenureChange?

  @@index([loanId])
}

enum MicroLoanPurpose {
  NEW_LOAN
  TOPUP
  INTEREST
  PENALTY
}

enum MicroLoanStatus {
  PENDING
  APPROVED
  REJECTED
  DISBURSED
}

// An asset request. microLoanId is the microloan that pays for it: the
// NEW_LOAN, linked when the loan is disbursed, or a TOPUP, linked when the
// top-up is requested.

model CommodityLoan {
  id             String                 @id @default(cuid())
  loanId         String
  commodityId    String
  status         CommodityRequestStatus @default(IN_REVIEW)
  microLoanId    String?                @unique
  publicDetails  String?
  privateDetails String?
  createdAt      DateTime               @default(now())

  loan      Loan       @relation(fields: [loanId], references: [id], onDelete: Cascade)
  commodity Commodity  @relation(fields: [commodityId], references: [id], onDelete: Restrict)
  microLoan MicroLoan? @relation(fields: [microLoanId], references: [id], onDelete: Restrict)

  @@index([loanId])
}

enum CommodityRequestStatus {
  IN_REVIEW
  APPROVED
  REJECTED
}

model Commodity {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  loans CommodityLoan[]
}

// A proposed change to a loan's tenure; monthsDelta is signed. Approval sets
// previousTenure and moves Loan.tenure. requestedById is null when the system
// proposed it (the net-pay cap after a default). A TOPUP change carries the
// top-up it was requested with. One PENDING change per loan — enforced in
// invariants.sql.

model TenureChange {
  id             String             @id @default(cuid())
  loanId         String
  previousTenure Int
  monthsDelta    Int
  reason         TenureChangeReason
  status         TenureChangeStatus @default(PENDING)
  microLoanId    String?            @unique
  requestedById  String?
  createdAt      DateTime           @default(now())

  loan        Loan       @relation(fields: [loanId], references: [id], onDelete: Restrict)
  microLoan   MicroLoan? @relation(fields: [microLoanId], references: [id], onDelete: Restrict)
  requestedBy Admin?     @relation("TenureChangeRequestedByAdmin", fields: [requestedById], references: [userId], onUpdate: Cascade)

  @@index([loanId])
}

enum TenureChangeReason {
  DEFAULT
  TOPUP
  LIQUIDATION
  ADMIN
}

enum TenureChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

// Money that arrived. Its period is the inflow's period. Payroll repayments
// settle a Deduction; liquidations have no deductionId and instead trigger
// a refresh of the OPEN Deduction. amount > 0 — enforced in invariants.sql.

model Repayment {
  id              String   @id @default(cuid())
  loanId          String
  paymentInflowId String   @unique
  deductionId     String?
  amount          Decimal  @db.Decimal(18, 2)
  createdAt       DateTime @default(now())

  loan          Loan                 @relation(fields: [loanId], references: [id], onDelete: Restrict)
  paymentInflow PaymentInflow        @relation(fields: [paymentInflowId], references: [id])
  deduction     Deduction?           @relation(fields: [deductionId], references: [id])
  breakdown     RepaymentBreakdown[]

  @@index([loanId])
  @@index([deductionId])
}

// What a loan is expected to pay in a payroll period.
//
//   OPEN      - `expected` is recomputed on every change to the loan's
//               owed/repaid/tenure. At most one per loan.
//   AWAITING  - the period's variation was submitted; `expected` is frozen
//               and is what payroll has on file. Waiting for the payroll
//               return. Submitting period P moves P's rows to AWAITING and
//               opens P+1 rows, so later penalties and top-ups land there.
//   FULFILLED / PARTIAL / FAILED - settled by the payroll return, or FAILED
//               at period close when nothing came in.
//
// A loan needs a new variation for P when OPEN(P).expected differs from its
// deduction for P-1.
//
// penalizedAt marks the period close that settled the row (penalty or not),
// so re-running the close skips it.
//
// One OPEN row per loan and expected >= 0 — enforced in invariants.sql.

model Deduction {
  id          String          @id @default(cuid())
  loanId      String
  periodId    String
  expected    Decimal         @db.Decimal(18, 2)
  status      DeductionStatus @default(OPEN)
  settledAt   DateTime?
  penalizedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  loan       Loan          @relation(fields: [loanId], references: [id], onDelete: Restrict)
  period     PayrollPeriod @relation(fields: [periodId], references: [id])
  repayments Repayment[]

  @@unique([loanId, periodId])
  @@index([periodId, status])
}

enum DeductionStatus {
  OPEN
  AWAITING
  FULFILLED
  PARTIAL
  FAILED
}

// One row per payroll month. variationSubmittedAt freezes the period's
// deductions and variationFilePath is the submitted sheet (private bucket);
// closedAt marks the month settled (any still-AWAITING deduction became
// FAILED).

model PayrollPeriod {
  id                   String    @id @default(cuid())
  month                Month
  year                 Int
  variationSubmittedAt DateTime?
  variationFilePath    String?
  closedAt             DateTime?
  createdAt            DateTime  @default(now())

  deductions     Deduction[]
  paymentInflows PaymentInflow[]
  uploads        PayrollUpload[]

  @@unique([year, month])
}

enum Month {
  JANUARY
  FEBRUARY
  MARCH
  APRIL
  MAY
  JUNE
  JULY
  AUGUST
  SEPTEMBER
  OCTOBER
  NOVEMBER
  DECEMBER
}

model RepaymentBreakdown {
  id          String             @id @default(cuid())
  repaymentId String
  amount      Decimal            @db.Decimal(18, 2)
  component   RepaymentComponent

  repayment Repayment @relation(fields: [repaymentId], references: [id], onDelete: Restrict)

  @@index([repaymentId])
}

enum RepaymentComponent {
  PRINCIPAL
  PENALTY
  INTEREST
}

// One government payroll return (Excel sheet) as uploaded. Each of its rows
// becomes a PAYROLL PaymentInflow. fileHash rejects the identical file early
// with a clear error; the row-level index on PaymentInflow is what actually
// prevents double counting. Undoing a wrong upload (e.g. the wrong period
// picked) removes exactly the inflows carrying its id.

model PayrollUpload {
  id           String   @id @default(cuid())
  periodId     String
  fileHash     String   @unique
  filename     String
  uploadedById String
  createdAt    DateTime @default(now())

  period     PayrollPeriod   @relation(fields: [periodId], references: [id])
  uploadedBy Admin           @relation(fields: [uploadedById], references: [userId], onUpdate: Cascade)
  inflows    PaymentInflow[]
}

// A payroll inflow is one row of a PayrollUpload; its periodId is the
// upload's (kept here for the index below). A liquidation has no upload and
// belongs to the period open when it arrived.
//
// A liquidation carries its proof: a path in the private proofs bucket.
//
// Re-uploading a payroll return must not double count: one PAYROLL row per
// employee per period — enforced in invariants.sql, as is the proof on every
// liquidation.

model PaymentInflow {
  id             String              @id @default(cuid())
  source         PaymentInflowSource
  periodId       String
  uploadId       String?
  amount         Decimal             @db.Decimal(18, 2)
  customerId     String?
  externalUserId String?
  state          PaymentInflowState  @default(UNMATCHED)
  proofPath      String?
  createdAt      DateTime            @default(now())

  period    PayrollPeriod  @relation(fields: [periodId], references: [id])
  upload    PayrollUpload? @relation(fields: [uploadId], references: [id])
  customer  Customer?      @relation(fields: [customerId], references: [userId], onUpdate: Cascade)
  repayment Repayment?

  @@index([customerId])
  @@index([periodId])
}

enum PaymentInflowSource {
  PAYROLL
  LIQUIDATION
  /// What an imported running loan had already repaid before it came over (the sheet's "amount paid").
  IMPORT
}

enum PaymentInflowState {
  UNMATCHED
  AWAITING
  REVIEWING
  SETTLED
  REJECTED
}

// Platform-wide settings: a single row (id = 1, enforced in
// invariants.sql). Set by a super admin on the dashboard, never seeded; a
// null rate means "not set yet". maxDeductionRate is the largest share of a
// customer's net pay the monthly deduction may take (null = no cap).

model Settings {
  id                Int      @id @default(1)
  interestRate      Decimal? @db.Decimal(5, 4)
  managementFeeRate Decimal? @db.Decimal(5, 4)
  penaltyRate       Decimal? @db.Decimal(5, 4)
  maxDeductionRate  Decimal? @db.Decimal(5, 4)
  inMaintenance     Boolean  @default(false)
  updatedAt         DateTime @updatedAt
}

// In-app notifications; readAt is null while unread.

model Notification {
  id              String    @id @default(cuid())
  userId          String
  title           String
  description     String
  callToActionUrl String?
  /// What an admin prompt is about (e.g. "liquidation:<inflowId>"): cleared for everyone once it is acted on.
  subject         String?
  readAt          DateTime?
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, createdAt])
  @@index([subject])
}

// A change to someone's details that waits for an admin: the customer's identity or payment
// method, or anyone's profile (name, email, phone) except a super admin's. `proposed`
// holds only the fields being changed; `previous` their values when they were asked for. A
// later edit of the same kind folds into the pending request. Approving writes `proposed` to
// the live record. One PENDING request per user and kind — enforced in invariants.sql.

model ChangeRequest {
  id          String              @id @default(cuid())
  userId      String
  kind        ChangeRequestKind
  status      ChangeRequestStatus @default(PENDING)
  proposed    Json
  previous    Json
  decidedById String?
  decidedAt   DateTime?
  note        String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  decidedBy Admin? @relation("ChangeRequestDecidedBy", fields: [decidedById], references: [userId], onUpdate: Cascade)

  @@index([status, kind, createdAt])
  @@index([userId, createdAt])
}

enum ChangeRequestKind {
  IDENTITY
  PAYMENT_METHOD
  PROFILE
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// What an admin (or the system actor) did, for the super admins' audit page. `meta` holds
// structured detail where a note isn't enough, e.g. a settings change's before and after.

model AuditLog {
  id         String          @id @default(cuid())
  actorId    String
  action     AuditAction
  entityType AuditEntityType
  entityId   String
  note       String?
  meta       Json?
  createdAt  DateTime        @default(now())

  actor Admin @relation(fields: [actorId], references: [userId], onUpdate: Cascade)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([actorId, createdAt])
}

enum AuditAction {
  LOAN_APPROVED
  LOAN_REJECTED
  LOAN_DISBURSED
  TOPUP_APPROVED
  TOPUP_REJECTED
  TOPUP_DISBURSED
  PENALTY_APPLIED
  TENURE_CHANGE_PROPOSED
  TENURE_CHANGE_APPROVED
  TENURE_CHANGE_REJECTED
  PAYMENT_INFLOW_APPROVED
  PAYMENT_INFLOW_REJECTED
  VARIATION_SUBMITTED
  VARIATION_REVERTED
  PERIOD_CLOSED
  COMMODITY_APPROVED
  COMMODITY_REJECTED
  CUSTOMER_STATUS_CHANGED
  CUSTOMER_OFFICER_CHANGED
  ADMIN_INVITED
  ADMIN_REMOVED
  PAYROLL_UPLOADED
  CHANGE_REQUEST_APPROVED
  CHANGE_REQUEST_REJECTED
  SETTINGS_UPDATED
  MAINTENANCE_TOGGLED
  COMMODITY_ADDED
  COMMODITY_UPDATED
  CUSTOMER_ONBOARDED
  CUSTOMERS_IMPORTED
  DATA_EXPORTED
  DOCUMENT_GENERATED
}

enum AuditEntityType {
  LOAN
  MICRO_LOAN
  TENURE_CHANGE
  PAYMENT_INFLOW
  PAYROLL_PERIOD
  COMMODITY_LOAN
  USER
  PAYROLL_UPLOAD
  CHANGE_REQUEST
  SETTINGS
  COMMODITY
  FILE
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime?
  aaguid       String?

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}
