# apps/backend/.env — copy to .env and fill in. Never commit .env.

# --- Database and cache ---
DATABASE_URL=postgresql://user:password@host:5432/railway
REDIS_URL=rediss://default:password@host:6379
# Bull queue key prefix (default "bull"). Give every environment that shares a Redis its own — local dev
# (e.g. mb2-dev), and production at the v2 cutover (e.g. mb2) so v1's leftover jobs never reach v2's workers.
BULL_PREFIX=mb2-dev

# --- better-auth (D1, D8) ---
# At least 32 random characters: `openssl rand -base64 36`
BETTER_AUTH_SECRET=
# Where browsers reach the API's /api/auth: the frontend origin (Vercel proxies it). Local: http://localhost:3000
BETTER_AUTH_URL=https://microbuiltprime.com
# The frontend, for links in emails (password reset). Local: http://localhost:3000
FRONTEND_URL=https://microbuiltprime.com
# Comma-separated origins allowed to call the API with cookies (CORS, CSRF, passkeys). Local: http://localhost:3000
FRONTEND_ORIGINS=https://microbuiltprime.com,https://www.microbuiltprime.com
# The API's own origin (Swagger at /docs calls /api/auth from here). Local: http://localhost:3003
API_ORIGIN=https://api.microbuiltprime.com
# Parent domain the session cookie is shared on, so direct uploads carry it (D8). Leave unset locally.
AUTH_COOKIE_DOMAIN=microbuiltprime.com
# Passkey relying party: the registrable domain. Local: localhost
PASSKEY_RP_ID=microbuiltprime.com
# Shared with the frontend (Vercel): proves that x-mb-client-ip came from its proxy. Same value on both.
EDGE_PROXY_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=

# --- SMS (Termii, D12); without a key texts are skipped with a warning ---
TERMII_API_KEY=
TERMII_SENDER_ID=MicroBuilt
TERMII_BASE_URL=https://api.ng.termii.com

# --- Storage (Supabase; private buckets, D10) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Sentry (D9; project microbuilt-be in org steffqing, EU) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
# The release on every event is RAILWAY_GIT_COMMIT_SHA, which Railway sets itself. Source maps are not uploaded
# (stack traces point at dist/*.js); wiring @sentry/cli would need SENTRY_ORG, SENTRY_PROJECT and SENTRY_AUTH_TOKEN.

# --- Runtime ---
PORT=3003
NODE_ENV=development

# --- Tests and scripts only ---
# LEDGER_IT=1 runs src/ledger/ledger.integration.spec.ts against DATABASE_URL (in 2099; cleans up after itself).
# scripts/smoke-v2.ts reads SMOKE_BASE (default http://localhost:3003).
