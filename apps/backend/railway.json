{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "pnpm --filter @microbuilt/backend... build",
    "watchPatterns": [
      "/apps/backend/**",
      "/packages/**",
      "/pnpm-lock.yaml",
      "/pnpm-workspace.yaml"
    ]
  },
  "deploy": {
    "startCommand": "node apps/backend/dist/main.js",
    "preDeployCommand": "pnpm --filter @microbuilt/backend db:deploy"
  }
}
