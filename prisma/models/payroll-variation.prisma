// The full PayrollSchedule remains the internal monthly repayment snapshot.
// These records contain only instructions changing what payroll has on file.
model PayrollVariationState {
  id              String   @id
  initializedAt   DateTime @default(now())
  initializedBy   String
  reference       String
  baselineBatchId String?
}

model PayrollVariationBatch {
  id                  String                 @id
  period              DateTime
  version             Int
  kind                String                 @default("VARIATION")
  status              PayrollVariationStatus @default(DRAFT)
  // Null preserves the original metadata of files generated before filters.
  changeFilter        String?
  excludedCount       Int                    @default(0)
  previewHash         String
  preparedBy          String
  recipientEmail      String?
  note                String?
  createdAt           DateTime               @default(now())
  sentAt              DateTime?
  sentBy              String?
  submissionReference String?
  emailedAt           DateTime?
  emailError          String?
  // Resend accepts an address before it knows the domain exists. emailedAt only
  // means "handed to the provider"; delivery is confirmed by webhook.
  emailMessageId      String?
  emailDeliveredAt    DateTime?
  artifactUrl         String?
  artifactHash        String?
  // PAYROLL is the confidential nine-column file payroll has always received.
  // DETAILED is the wider layout some existing artifacts were built with, kept
  // only so those saved submissions still reproduce byte for byte.
  artifactLayout      String                 @default("PAYROLL")
  internalScheduleId  String?
  sourceScheduleId    String?                @unique
  internalSchedule    PayrollSchedule?       @relation(fields: [internalScheduleId], references: [id])
  rows                PayrollVariationRow[]

  @@unique([period, version])
  @@index([status, period])
  @@index([emailMessageId])
}

model PayrollVariationRow {
  id                     String                 @id
  batchId                String
  borrowerId             String
  obligationId           String
  installmentId          String?
  planId                 String?
  previousRowId          String?
  action                 PayrollVariationAction
  reasons                String[]
  sourceEventIds         String[]
  changeTypes            String[]               @default([])
  externalId             String
  borrowerName           String
  command                String
  previousAmount         Decimal?               @db.Decimal(18, 2)
  amount                 Decimal                @db.Decimal(18, 2)
  contractualOutstanding Decimal                @db.Decimal(18, 2)
  penaltyOutstanding     Decimal                @db.Decimal(18, 2)
  totalOutstanding       Decimal                @db.Decimal(18, 2)
  termRemaining          Int
  effectiveFromPeriod    DateTime
  endDate                DateTime?
  instructionHash        String
  batch                  PayrollVariationBatch  @relation(fields: [batchId], references: [id])

  @@unique([batchId, borrowerId])
  @@unique([batchId, externalId])
  @@index([borrowerId, effectiveFromPeriod])
}

enum PayrollVariationStatus {
  DRAFT
  PREPARED
  SENT
}

enum PayrollVariationAction {
  START
  AMEND
  STOP
}
